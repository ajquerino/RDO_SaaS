# ================= IndustrialOS — variáveis de PRODUÇÃO =================
# Copie para ".env" (na mesma pasta do docker-compose.prod.yml) e preencha.
# NUNCA comite o .env com valores reais (ele está no .gitignore).
# O .NET lê variáveis de ambiente e SOBREPÕE o appsettings.json.
# Convenção: "__" (duplo underscore) vira ":" na config — ex.: R2__Bucket => R2:Bucket.

# ---- Ambiente ----
ASPNETCORE_ENVIRONMENT=Production

# ---- Postgres (serviço "postgres" do docker-compose.prod.yml) ----
# Estas 3 criam o banco dentro do container. Devem CASAR com ConnectionStrings__Postgres abaixo.
POSTGRES_USER=industrialos
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=industrialos

# ---- Conexão do backend com o banco ----
# No docker-compose, o Host é o NOME DO SERVIÇO do banco: "postgres".
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=industrialos;Username=industrialos;Password=troque-esta-senha-forte

# ---- JWT (autenticação) ----
# Gere uma chave forte com no mínimo 32 caracteres. Ex.: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=industrialos
Jwt__Audience=industrialos

# ---- Cloudflare R2 (armazenamento de fotos/vídeos/PDFs) ----
R2__AccountId=
R2__Bucket=industrialos
R2__AccessKeyId=
R2__SecretAccessKey=

# ---- Super-admin inicial (criado automaticamente no 1º boot) ----
Seed__SuperAdminEmail=
Seed__SuperAdminSenha=

# ---- Frontend ----
# ATENÇÃO: lido em BUILD TIME pelo Vite (frontend/src/lib/api.ts). Se mudar, tem que
# reconstruir o container do frontend. Aponte para onde a API responde publicamente.
# Ex.: http://SEU_IP:8080  (ou https://api.seudominio.com atrás de um proxy/HTTPS)
VITE_API_URL=http://localhost:8080
